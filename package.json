{
  "name": "trip-expense-ledger",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf-typegen": "wrangler types",
    "pretypecheck": "npm run cf-typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply trip-expense-ledger-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trip-expense-ledger-db --remote",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.15.1",
    "drizzle-orm": "0.36.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.5.5",
    "drizzle-kit": "0.31.10",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6.2",
    "vitest": "2.1.1",
    "wrangler": "^4.129.0"
  }
}
