# --- Secrets / credentials (never commit) ---
.env
.env.*
.dev.vars
!.env.example
*.pem
*.key
*.p12
*credentials*.json
*token*
*secret*
*.crt

# --- Cloudflare / OpenNext ---
.open-next/
.wrangler/
worker-configuration.d.ts

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Next.js ---
.next/
out/
.vercel
next-env.d.ts

# --- TypeScript ---
*.tsbuildinfo

# --- SQLite / app data (self-hosted runtime data, never commit) ---
*.sqlite
*.sqlite3
*.db
/data/
uploads/
receipts/

# --- Drizzle (generated migration meta, keep migrations/*.sql, ignore local journal if needed) ---
# 注: drizzle 生成的 migrations/*.sql 应该提交进版本控制，这里不忽略 migrations 目录本身

# --- Testing / coverage ---
coverage/
.vitest-cache/

# --- Build / misc ---
dist/
build/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Docker local overrides ---
docker-compose.override.yml
